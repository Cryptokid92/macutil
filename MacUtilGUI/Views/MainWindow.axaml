<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacUtilGUI.ViewModels"
        xmlns:svc="using:MacUtilGUI.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="MacUtilGUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="600"
        Background="#1C1C1E"
        TransparencyLevelHint="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Border Background="#80000000" Padding="20" Classes="macos-window" CornerRadius="15">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="32" Margin="-20,-20,-20,0" Background="#80000000" PointerPressed="TitleBar_PointerPressed">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,6,0,0" Spacing="8">
                <Button Width="12" Height="12" CornerRadius="6" Background="#FF5F57" Classes="macos-window-control" Cursor="Hand" Click="OnCloseButtonClick"/>
                <Button Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" Classes="macos-window-control" Cursor="Hand" Click="OnMinimizeButtonClick"/>
                <Button Width="12" Height="12" CornerRadius="6" Background="#28CA42" Classes="macos-window-control" Cursor="Hand" Click="OnMaximizeButtonClick"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="MacUtil"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Classes="macos-body"
                       FontSize="13"
                       FontWeight="Medium"/>

            <Border Grid.Column="2" Width="80"/>
        </Grid>

        <TabControl Grid.Row="1" Margin="-20,8,-20,-20" Classes="macos-tabs">
            <TabItem Header="Tweaks">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" Margin="24,16,24,8">
                        <StackPanel>
                            <TextBlock Text="Tweaks"
                                       Classes="macos-title"
                                       FontSize="18"
                                       Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding SafeTweaks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TweakRowViewModel">
                                        <CheckBox Classes="macos-tweak"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}" Classes="macos-body"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Classes="macos-secondary"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Caution"
                                       Classes="macos-caution"
                                       FontSize="16"
                                       Margin="0,20,0,12"/>
                            <ItemsControl ItemsSource="{Binding CautionTweaks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TweakRowViewModel">
                                        <CheckBox Classes="macos-tweak"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}" Classes="macos-body"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Classes="macos-secondary"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Padding="24,12" Background="#772C2C2E">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Apply"
                                    Command="{Binding ApplyCommand}"
                                    Classes="macos-accent"
                                    Padding="20,10"/>
                            <Button Content="Undo"
                                    Command="{Binding UndoCommand}"
                                    Classes="macos-quiet"
                                    Padding="20,10"/>
                            <Button Content="Standard"
                                    Command="{Binding SelectStandardCommand}"
                                    Classes="macos-quiet"
                                    Padding="20,10"/>
                            <Button Content="Minimal"
                                    Command="{Binding SelectMinimalCommand}"
                                    Classes="macos-quiet"
                                    Padding="20,10"/>
                            <Button Content="Export"
                                    Click="OnExportClick"
                                    Classes="macos-quiet"
                                    Padding="20,10"/>
                            <Button Content="Import"
                                    Click="OnImportClick"
                                    Classes="macos-quiet"
                                    Padding="20,10"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Classes="macos-secondary"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Install">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBox Grid.Row="0"
                             Text="{Binding SearchText}"
                             Watermark="Search"
                             Classes="macos-search"
                             Margin="24,16,24,8"/>
                    <ScrollViewer Grid.Row="1" Margin="24,0,24,8">
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppRowViewModel">
                                    <CheckBox Classes="macos-tweak"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" Classes="macos-body"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Classes="macos-secondary"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="24,12" Background="#772C2C2E">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Install"
                                    Command="{Binding InstallCommand}"
                                    Classes="macos-accent"
                                    Padding="20,10"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Classes="macos-secondary"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Maintenance">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" Margin="24,16,24,8">
                        <StackPanel>
                            <TextBlock Text="Maintenance"
                                       Classes="macos-title"
                                       FontSize="18"
                                       Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding MaintenanceActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="svc:MaintenanceAction">
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding Content}" Classes="macos-body"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Classes="macos-secondary"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Padding="24,12" Background="#772C2C2E">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Brew update"
                                    Command="{Binding BrewUpdateCommand}"
                                    Classes="macos-quiet"
                                    Padding="20,10"/>
                            <Button Content="Brew cleanup"
                                    Command="{Binding BrewCleanupCommand}"
                                    Classes="macos-accent"
                                    Padding="20,10"/>
                            <Button Content="Homebrew cache"
                                    Command="{Binding UserCacheBrewCommand}"
                                    Classes="macos-quiet"
                                    Padding="20,10"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Classes="macos-secondary"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Updates">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" Margin="24,16,24,8">
                        <StackPanel>
                            <TextBlock Text="Updates"
                                       Classes="macos-title"
                                       FontSize="18"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SystemSettingsHelp}"
                                       Classes="macos-secondary"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="Apple"
                                       Classes="macos-title"
                                       FontSize="16"
                                       Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding AppleUpdates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppleUpdateRowViewModel">
                                        <CheckBox Classes="macos-tweak"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsEnabled}"
                                                  Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}"
                                                           Classes="macos-body"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Classes="macos-secondary"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Homebrew"
                                       Classes="macos-title"
                                       FontSize="16"
                                       Margin="0,20,0,12"/>
                            <ItemsControl ItemsSource="{Binding BrewOutdated}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BrewOutdatedRowViewModel">
                                        <CheckBox Classes="macos-tweak"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}"
                                                           Classes="macos-body"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Classes="macos-secondary"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Padding="24,12" Background="#772C2C2E">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Refresh"
                                    Command="{Binding RefreshUpdatesCommand}"
                                    Classes="macos-quiet"
                                    Padding="20,10"/>
                            <Button Content="Copy command"
                                    Click="OnCopyUpdateClick"
                                    Classes="macos-quiet"
                                    Padding="20,10"/>
                            <Button Content="Update Homebrew"
                                    Command="{Binding UpdateHomebrewCommand}"
                                    Classes="macos-accent"
                                    Padding="20,10"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Classes="macos-secondary"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </Border>
</Window>
